{
  "repo": "skymoonsun/model-maestro",
  "language": "python",
  "framework": "fastapi",
  "defaultBranch": "develop",
  "testCommand": "cd /root/projects/model-maestro && python -m pytest tests/ -v",
  "testFramework": "pytest",
  "claudeModel": "glm-5:cloud",
  "maxReviewIterations": 3,
  "conventions": {
    "commitStyle": "conventional",
    "branchPrefix": ["feature/", "fix/", "hotfix/"],
    "prTarget": "develop"
  }
}
