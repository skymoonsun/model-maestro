#!/usr/bin/env bash
set -euo pipefail

# codex-maestro — Launch Codex Desktop App with Model Maestro backend
# Uses the Ollama-launch pattern: rewrites config.toml with a dedicated
# profile + model_provider + model_catalog_json.
#
# USAGE:
#   ./scripts/codex-maestro
#
#   # Non-interactive
#   MAESTRO_URL=https://maestro.gokaygunes.com/v1 MAESTRO_TOKEN=xxx \
#     MAESTRO_MODEL=kimi-k2.6:latest \
#     ./scripts/codex-maestro

# ── Colors ─────────────────────────────────────────────────────
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
RESET='\033[0m'

# ── Defaults ───────────────────────────────────────────────────
DEFAULT_URL="https://maestro.gokaygunes.com/v1"
DEFAULT_MODEL="kimi-k2.6:latest"

# ── Env var overrides ──────────────────────────────────────────
MAESTRO_URL="${MAESTRO_URL:-}"
MAESTRO_TOKEN="${MAESTRO_TOKEN:-}"
MAESTRO_MODEL="${MAESTRO_MODEL:-}"

# ── Paths ──────────────────────────────────────────────────────
CODEX_HOME="${HOME}/.codex"
CONFIG_TOML="${CODEX_HOME}/config.toml"
CONFIG_BACKUP="${CODEX_HOME}/config.toml.maestro-backup"
MODELS_JSON="${CODEX_HOME}/maestro-launch-models.json"

# ── Prompt helpers ─────────────────────────────────────────────
prompt() {
    local msg="$1"
    local default="${2:-}"
    local input
    if [ -n "$default" ]; then
        printf "${CYAN}${msg}${RESET} [${BOLD}%s${RESET}]: " "$default" >&2
    else
        printf "${CYAN}${msg}${RESET}: " >&2
    fi
    IFS= read -r input
    if [ -z "$input" ] && [ -n "$default" ]; then
        input="$default"
    fi
    printf '%s\n' "$input"
}

prompt_secret() {
    local msg="$1"
    local input
    printf "${CYAN}${msg}${RESET}: " >&2
    if stty -echo 2>/dev/null; then
        trap 'stty echo 2>/dev/null; printf "\n" >&2' HUP INT TERM EXIT
        IFS= read -r input
        stty echo 2>/dev/null || true
        trap - HUP INT TERM EXIT 2>/dev/null || true
        printf '\n' >&2
    else
        IFS= read -r input
    fi
    printf '%s\n' "$input"
}

# ── Config.toml management ─────────────────────────────────────
backup_config() {
    if [ -f "$CONFIG_TOML" ]; then
        cp "$CONFIG_TOML" "$CONFIG_BACKUP"
    fi
}

restore_config() {
    if [ -f "$CONFIG_BACKUP" ]; then
        mv "$CONFIG_BACKUP" "$CONFIG_TOML"
    fi
}

# ── Fetch model catalog ──────────────────────────────────────────
fetch_model_catalog() {
    local url="$1"
    local token="$2"
    local out="$3"

    echo "${CYAN}Fetching model catalog from Maestro...${RESET}" >&2

    local catalog_url
    if [[ "$url" == */v1 ]]; then
        catalog_url="${url%/v1}/codex/models"
    elif [[ "$url" == */v1/ ]]; then
        catalog_url="${url%/v1/}/codex/models"
    else
        catalog_url="${url}/codex/models"
    fi

    if curl -sS -f -H "Authorization: Bearer ${token}" \
         -o "$out" "$catalog_url" 2>/dev/null; then
        echo "${GREEN}  Model catalog saved to ${out}${RESET}" >&2
    else
        echo "${YELLOW}  Warning: Could not fetch catalog${RESET}" >&2
        echo "${YELLOW}  Creating fallback catalog...${RESET}" >&2
        echo '{"models":[{"id":"'"$MAESTRO_MODEL"'","name":"'"$MAESTRO_MODEL"'","object":"model","created":0,"owned_by":"maestro","context_window":262144,"max_context_window":262144,"effective_context_window_percent":95,"description":"Maestro model","display_name":"'"$MAESTRO_MODEL"'","slug":"'"$MAESTRO_MODEL"'","priority":0,"shell_type":"default","input_modalities":["text","image"],"supported_in_api":true,"supports_image_detail_original":true,"supports_parallel_tool_calls":false,"supports_reasoning_summaries":false,"supports_search_tool":false,"support_verbosity":false,"truncation_policy":{"limit":10000,"mode":"bytes"},"default_reasoning_summary":"auto","visibility":"list","web_search_tool_type":"text","additional_speed_tiers":[],"apply_patch_tool_type":null,"auto_compact_token_limit":null,"availability_nux":null,"base_instructions":"You are Codex, a helpful coding assistant.","default_reasoning_level":null,"default_verbosity":null,"experimental_supported_tools":[],"model_messages":null,"supported_reasoning_levels":[],"upgrade":null}]}' > "$out"
    fi
}

# ── Write config.toml ──────────────────────────────────────────
write_config() {
    local base_url="$1"
    local model="$2"

    local codex_base
    if [[ "$base_url" == */v1 ]]; then
        codex_base="${base_url%/v1}/codex/"
    elif [[ "$base_url" == */v1/ ]]; then
        codex_base="${base_url%/v1/}/codex/"
    else
        codex_base="${base_url}/codex/"
    fi

    local provider="maestro-launch-codex-app"

    # Preserve existing [projects] entries by cat'ing them back
    local projects_block=""
    if [ -f "$CONFIG_TOML" ]; then
        if grep -q '\\[projects\\.' "$CONFIG_TOML" 2>/dev/null; then
            projects_block=$(
                sed -n '/\[projects\./,$p' "$CONFIG_TOML" 2>/dev/null || true
            )
        fi
    fi

    cat > "$CONFIG_TOML" <<EOF
profile = "${provider}"

model = "${model}"

model_provider = "${provider}"

model_catalog_json = "${MODELS_JSON}"

notify = ["${HOME}/.codex/computer-use/Codex Computer Use.app/Contents/SharedSupport/SkyComputerUseClient.app/Contents/MacOS/SkyComputerUseClient", "turn-ended"]

[profiles.${provider}]
model = "${model}"
openai_base_url = "${codex_base}"
model_provider = "${provider}"
model_catalog_json = "${MODELS_JSON}"

[model_providers.${provider}]
name = "Maestro"
base_url = "${codex_base}"
wire_api = "chat_completions"

[marketplaces.openai-bundled]
last_updated = "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
source_type = "local"
source = "${HOME}/.codex/.tmp/bundled-marketplaces/openai-bundled"

[features]
js_repl = false

[mcp_servers.node_repl]
args = []
command = "/Applications/Codex.app/Contents/Resources/node_repl"
startup_timeout_sec = 120

[mcp_servers.node_repl.env]
BROWSER_USE_AVAILABLE_BACKENDS = "chrome,iab"
BROWSER_USE_MARKETPLACE_NAME = "openai-bundled"
CODEX_CLI_PATH = "/Applications/Codex.app/Contents/Resources/codex"
CODEX_HOME = "${HOME}/.codex"
NODE_REPL_NATIVE_PIPE_CONNECT_TIMEOUT_MS = "1000"
NODE_REPL_NODE_MODULE_DIRS = ""
NODE_REPL_NODE_PATH = "/Applications/Codex.app/Contents/Resources/node"
NODE_REPL_TRUSTED_BROWSER_CLIENT_SHA256S = "167fdf579477181fba1773c1efb067b00c5a64fe85dafb50a2001bde198dc739"
NODE_REPL_TRUSTED_CODE_PATHS = "${HOME}/.codex"
NODE_REPL_UNTRUSTED_ENV_ALLOWLIST = "BROWSER_USE_MARKETPLACE_NAME"

[plugins."browser@openai-bundled"]
enabled = true
EOF

    # Append preserved project trust blocks
    if [ -n "$projects_block" ]; then
        echo "" >> "$CONFIG_TOML"
        echo "$projects_block" >> "$CONFIG_TOML"
    fi
}

# ── Banner ─────────────────────────────────────────────────────
echo "${BOLD}"
echo '  Codex + Model Maestro Launcher  '
echo "${RESET}"

# ── Prompts ────────────────────────────────────────────────────
if [ -z "$MAESTRO_URL" ]; then
    MAESTRO_URL=$(prompt "Maestro Base URL" "$DEFAULT_URL")
fi

if [ -z "$MAESTRO_TOKEN" ]; then
    echo ""
    echo "${YELLOW}Your Maestro JWT token is required.${RESET}"
    echo "  Get it from: ${BOLD}Maestro Admin Panel → Users → Token${RESET}"
    echo ""
    MAESTRO_TOKEN=$(prompt_secret "Maestro JWT Token")
fi

if [ -z "$MAESTRO_MODEL" ]; then
    MAESTRO_MODEL=$(prompt "Default Model" "$DEFAULT_MODEL")
fi

if [ -z "$MAESTRO_URL" ] || [ -z "$MAESTRO_TOKEN" ]; then
    echo "Error: URL and token are required." >&2
    exit 1
fi

echo ""
echo "${BOLD}Launch Configuration:${RESET}"
echo "  Provider: Model Maestro"
echo "  Base URL: $MAESTRO_URL"
echo "  Model:    $MAESTRO_MODEL"
echo ""

# ── Env vars ───────────────────────────────────────────────────
export OPENAI_BASE_URL="$MAESTRO_URL"
export OPENAI_API_KEY="$MAESTRO_TOKEN"
export MAESTRO_API_KEY="$MAESTRO_TOKEN"

# ── Fetch catalog ──────────────────────────────────────────────
fetch_model_catalog "$MAESTRO_URL" "$MAESTRO_TOKEN" "$MODELS_JSON"

# ── Write config ─────────────────────────────────────────────────
echo "${CYAN}Writing Maestro launch config...${RESET}" >&2
backup_config
write_config "$MAESTRO_URL" "$MAESTRO_MODEL"
echo "${GREEN}  Config written${RESET}" >&2

# ── Cleanup ────────────────────────────────────────────────────
cleanup() {
    echo ""
    echo "${CYAN}Restoring original config...${RESET}" >&2
    restore_config
    echo "${GREEN}Done.${RESET}" >&2
}
trap cleanup EXIT INT TERM

# ── Launch ───────────────────────────────────────────────────────
echo ""
echo "${CYAN}Launching Codex Desktop App...${RESET}" >&2
echo "  Quit with Cmd+Q to restore config" >&2

echo ""
/Applications/Codex.app/Contents/MacOS/Codex "$@" &
CODEX_PID=$!
echo "  PID: $CODEX_PID"
wait $CODEX_PID || true
