# Ollama server URL
# macOS/Windows: http://host.docker.internal:11434
# Linux (with network_mode: host): http://localhost:11434
# Linux (with custom IP): http://172.17.0.1:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Ollama Official Cloud API (for Web Search)
OLLAMA_WEB_SEARCH_URL=https://ollama.com/api/web_search
OLLAMA_API_KEY=your_ollama_api_key

# JWT secret key for token signing (CHANGE THIS!)
JWT_SECRET_KEY=your-secret-key-here-change-this-to-a-random-string

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# PostgreSQL Database Configuration
# Format: postgresql://user:password@host:port/database
# Or use asyncpg driver: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/ollama_proxy

# Admin Token for admin endpoints (CHANGE THIS!)
# Generate with: openssl rand -hex 32
ADMIN_TOKEN=admin-super-secret-token-change-this-in-production

# Redis Configuration
# Format: redis://host:port/db
REDIS_URL=redis://localhost:6379/0

# Swagger/Docs Basic Auth (username:password)
DOCS_USERNAME=admin
DOCS_PASSWORD=secure_docs_password_change_this

# Model Switching & Fallback Configuration
# Comma-separated list of models to try in order (primary → fallback1 → fallback2)
FALLBACK_CHAIN=github-copilot/claude-opus-4.6,kimi-k2.5,qwen3.5

# Response timeout threshold in seconds (slower responses trigger model switch)
MODEL_TIMEOUT_THRESHOLD=4.0

# Maximum retry attempts per model before moving to next in chain
MODEL_MAX_RETRIES=3

