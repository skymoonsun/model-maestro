# Ollama server URL
# macOS/Windows: http://host.docker.internal:11434
# Linux (with network_mode: host): http://localhost:11434
# Linux (with custom IP): http://172.17.0.1:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434

# JWT secret key for token signing (CHANGE THIS!)
JWT_SECRET_KEY=your-secret-key-here-change-this-to-a-random-string

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

