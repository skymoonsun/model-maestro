# Ollama server URL
# macOS/Windows: http://host.docker.internal:11434
# Linux (with network_mode: host): http://localhost:11434
# Linux (with custom IP): http://172.17.0.1:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Ollama Official Cloud API (for Web Search)
OLLAMA_WEB_SEARCH_URL=https://ollama.com/api/web_search
OLLAMA_API_KEY=your_ollama_api_key

# JWT secret key for token signing (CHANGE THIS!)
JWT_SECRET_KEY=your-secret-key-here-change-this-to-a-random-string

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# PostgreSQL Database Configuration
# Format: postgresql://user:password@host:port/database
# Or use asyncpg driver: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/maestro

# Admin Token for admin endpoints (CHANGE THIS!)
# Generate with: openssl rand -hex 32
ADMIN_TOKEN=admin-super-secret-token-change-this-in-production

# Redis Configuration
# Format: redis://host:port/db
REDIS_URL=redis://localhost:6379/0

# Swagger/Docs Basic Auth (username:password)
DOCS_USERNAME=admin
DOCS_PASSWORD=secure_docs_password_change_this

# Google OAuth 2.0 for Antigravity nodes
# Get credentials from: https://github.com/lbjlaq/Antigravity-Manager
# Or create your own at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/admin/oauth/callback